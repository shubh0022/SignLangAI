# Backend environment variables for local development and production.
# Use this example to create a local .env file or configure Vercel environment variables.

# MySQL Database Configuration
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=signlangai_db

# MongoDB Atlas Configuration
# Replace <username>, <password>, <cluster> and <dbname> with your Atlas values.
MONGO_URL=mongodb+srv://shubham_db_user:shubham%4025@signlangai.a2nsnve.mongodb.net/?appName=SignLangAI
MONGO_DB_NAME=SignLangAI

# On Vercel, add these variables under Project Settings > Environment Variables.
